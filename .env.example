DISCORD_TOKEN=your_discord_bot_token
# Optional: required for Spotify metadata (not Spotify audio streaming)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Playlist polling interval; minimum 5 minutes
SYNC_MINUTES=30
# Optional: full path to ffmpeg executable, if it isn't found automatically
# FFMPEG_PATH=C:\ffmpeg\bin\ffmpeg.exe
